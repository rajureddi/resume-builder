# ── Resume Studio — environment variables (placeholders only, no real secrets) ──
# Copy to .env.local for local dev, or set the same names in Vercel → Project → Settings → Environment Variables.

# Postgres database (Neon). If unset, the app falls back to a local JSON file
# store (demo mode — data does NOT persist reliably on Vercel without this).
DATABASE_URL=postgres://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require

# Site lock. STRONGLY recommended on Vercel — the deployment URL is public.
# Anyone opening the site must enter this password. Leave unset = no lock.
APP_PASSWORD=choose-a-strong-password

# Random string used to sign the login session cookie.
SESSION_SECRET=generate-a-long-random-string

# Optional: Groq API key as an env fallback. You can also paste the key inside
# the app (Settings → AI Settings), where it is saved to the database instead.
# Groq keys start with gsk_ and are created at console.groq.com → API Keys.
GROQ_API_KEY=gsk_your_key_here

# Optional overrides for the LLM endpoint/model (defaults shown).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Optional: path for the JSON fallback data file (local dev only).
# DATA_FILE=./data/db.json
